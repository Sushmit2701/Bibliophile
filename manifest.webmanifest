{
  "name": "Bibliophile",
  "short_name": "Bibliophile",
  "description": "Your personal commonplace book: books, highlights, quotes and reviews.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f1ec",
  "theme_color": "#e8501f",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Start reading timer", "short_name": "Timer", "url": "./#/timer", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Save a passage", "short_name": "Save", "url": "./?do=add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily review", "short_name": "Review", "url": "./#/review", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
